---
/**
 * Footer.astro
 * Site footer. Kit-level component — lives in kits/[kit]/src/components/.
 * Not part of packages/components — uses astro:content directly.
 *
 * Layout: 3-column at desktop, stacked on mobile.
 *   Col 1: Logo + tagline + social links
 *   Col 2: Nav links (reuses site_settings.nav)
 *   Col 3: Contact details (phone, email, address) + optional CTA link
 *
 * Bottom row: copyright + optional legal links (privacy, terms).
 *
 * No props — reads all data from site_settings CMS singleton.
 * Legal links (privacy policy, terms) are hardcoded paths — kit author
 * adds pages if the client needs them.
 *
 * Kit customisation:
 *   The legal links array below is the one thing kit authors edit in this file.
 *   Everything else comes from the CMS.
 */

import { getEntry } from 'astro:content';

const settingsEntry = await getEntry('site_settings', 'general');
const settings = settingsEntry?.data;

const siteName = settings?.site_name ?? 'Site';
const tagline = settings?.tagline;
const logo = settings?.logo;
const navLinks = settings?.nav ?? [];
const contact = settings?.contact;
const social = settings?.social;

const currentYear = new Date().getFullYear();

// Kit author: add, remove, or rename these as needed.
// Delete the array entry if the client has no privacy policy yet.
const legalLinks = [
  { label: 'Privacy policy', href: '/privacy' },
  { label: 'Terms of use', href: '/terms' },
];

// Social links — only render if a URL is set in CMS
interface SocialLink {
  label: string;
  href: string | undefined;
  icon: string; // Inline SVG path data
}

const socialLinks: SocialLink[] = [
  {
    label: 'Facebook',
    href: social?.facebook,
    icon: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  },
  {
    label: 'Instagram',
    href: social?.instagram,
    icon: 'M16 2H8a6 6 0 0 0-6 6v8a6 6 0 0 0 6 6h8a6 6 0 0 0 6-6V8a6 6 0 0 0-6-6zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm4.5-9a1 1 0 1 1 0-2 1 1 0 0 1 0 2z',
  },
  {
    label: 'LinkedIn',
    href: social?.linkedin,
    icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  },
  {
    label: 'X / Twitter',
    href: social?.x,
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'YouTube',
    href: social?.youtube,
    icon: 'M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12z',
  },
].filter((s) => s.href);
---

<footer
  class='footer'
  aria-label='Site footer'
>
  <div class='footer__inner'>
    {/* ── TOP GRID ─────────────────────────────────── */}
    <div class='footer__grid'>
      {/* Col 1 — brand */}
      <div class='footer__brand'>
        <a
          href='/'
          class='footer__logo-link'
          aria-label={`${siteName} — home`}
        >
          {
            logo ? (
              <img
                src={logo}
                alt={siteName}
                class='footer__logo-img'
                width={120}
                height={40}
                loading='lazy'
                decoding='async'
              />
            ) : (
              <span class='footer__logo-text'>{siteName}</span>
            )
          }
        </a>

        {tagline && <p class='footer__tagline'>{tagline}</p>}

        {/* Social links */}
        {
          socialLinks.length > 0 && (
            <ul
              class='footer__social'
              aria-label='Social media links'
            >
              {socialLinks.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class='footer__social-link'
                    aria-label={s.label}
                    target='_blank'
                    rel='noopener noreferrer'
                  >
                    <svg
                      width='18'
                      height='18'
                      viewBox='0 0 24 24'
                      fill='currentColor'
                      aria-hidden='true'
                      focusable='false'
                    >
                      <path d={s.icon} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {/* Col 2 — nav links */}
      {
        navLinks.length > 0 && (
          <nav
            class='footer__nav'
            aria-label='Footer navigation'
          >
            <p class='footer__col-heading'>Navigation</p>
            <ul class='footer__nav-list'>
              {navLinks.map((link: { label: string; href: string }) => (
                <li>
                  <a
                    href={link.href}
                    class='footer__nav-link'
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {/* Col 3 — contact */}
      {
        contact && (
          <div class='footer__contact'>
            <p class='footer__col-heading'>Get in touch</p>
            <ul class='footer__contact-list'>
              {contact.phone && (
                <li>
                  <a
                    href={`tel:${contact.phone.replace(/\s/g, '')}`}
                    class='footer__contact-link'
                  >
                    Phone: {contact.phone}
                  </a>
                </li>
              )}
              {contact.fax && (
                <li>
                  <a
                    href={`tel:${contact.fax.replace(/\s/g, '')}`}
                    class='footer__contact-link'
                  >
                    Fax:
                    {contact.fax}
                  </a>
                </li>
              )}
              {contact.email && (
                <li>
                  <a
                    href={`mailto:${contact.email}`}
                    class='footer__contact-link'
                  >
                    {contact.email}
                  </a>
                </li>
              )}
              {contact.address && (
                <li class='footer__address'>
                  <address>{contact.address}</address>
                </li>
              )}
              {contact.service_area && <li class='footer__service-area'>{contact.service_area}</li>}
              <li>
                <form
                  name='PrePage'
                  method='post'
                  action='https://Simplecheckout.authorize.net/payment/CatalogPayment.aspx'
                >
                  <input
                    type='hidden'
                    name='LinkId'
                    value='8bb24ee6-1399-4e81-a672-958a1f42c922'
                  />
                  <input
                    type='submit'
                    class='footer__payment-link'
                    value='Pay Your Bill'
                  />
                </form>
              </li>
            </ul>
          </div>
        )
      }
    </div>

    {/* ── BOTTOM ROW ───────────────────────────────── */}
    <div class='footer__bottom'>
      <p class='footer__copyright'>
        &copy; {currentYear}
        {siteName}. All rights reserved.
      </p>

      {
        legalLinks.length > 0 && (
          <nav aria-label='Legal links'>
            <ul class='footer__legal'>
              {legalLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class='footer__legal-link'
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</footer>

<style>
  /* ============================================================
     FOOTER
     ============================================================ */

  .footer {
    background-color: var(--color-surface-inverse);
    padding-block-start: var(--space-2xl);
    padding-block-end: var(--space-l);
    padding-inline: var(--gutter);
  }

  .footer__inner {
    max-width: var(--max-width-content);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ============================================================
     TOP GRID — 1 col mobile, 3 col desktop
     ============================================================ */

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 600px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
  }

  /* ============================================================
     COL 1 — BRAND
     ============================================================ */

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .footer__logo-link {
    display: inline-flex;
    text-decoration: none;
  }

  .footer__logo-img {
    height: 4rem;
    width: auto;
    display: block;
    /* Invert for dark footer background */
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer__logo-text {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
    letter-spacing: var(--tracking-snug);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-text-inverse) 60%, transparent);
    margin: 0;
    max-width: 30ch;
  }

  /* ============================================================
     SOCIAL LINKS
     ============================================================ */

  .footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-xs);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-text-inverse) 10%, transparent);
    color: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-default),
      color var(--duration-fast) var(--ease-default);
  }

  .footer__social-link:hover {
    background-color: var(--color-accent);
    color: var(--color-text-inverse);
  }

  .footer__social-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color-inverse);
    outline-offset: var(--focus-ring-offset);
  }

  /* ============================================================
     COLUMN HEADING — "Navigation", "Get in touch"
     <p> not <h2/h3> — footer columns are not content sections
     ============================================================ */

  .footer__col-heading {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text-inverse) 50%, transparent);
    margin: 0 0 var(--space-s);
  }

  /* ============================================================
     COL 2 — NAV LINKS
     ============================================================ */

  .footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer__nav-link {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__payment-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-block: calc(var(--btn-padding-y) * 0.5);
    padding-inline: calc(var(--btn-padding-x) * 0.75);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    border-radius: var(--btn-radius);
    text-decoration: none;
    transition: var(--btn-transition);
    cursor: pointer;
    white-space: nowrap;
    border: 2px solid var(--color-text-inverse);
    background-color: var(--color-text-inverse);
    color: var(--color-surface-inverse);
  }

  .footer__payment-link:hover {
    background-color: transparent;
    color: var(--color-text-inverse);
    transform: translateY(-1px);
  }

  .footer__nav-link:hover {
    color: var(--color-text-inverse);
  }

  .footer__nav-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color-inverse);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  /* ============================================================
     COL 3 — CONTACT
     ============================================================ */

  .footer__contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer__contact-link {
    font-size: var(--text-md);
    font-weight: 600;
    color: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__contact-link:hover {
    color: var(--color-text-inverse);
  }

  .footer__contact-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color-inverse);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  .footer__address,
  .footer__service-area {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-text-inverse) 55%, transparent);
    line-height: var(--leading-relaxed);
  }

  /* <address> resets browser italic default */
  .footer__address address {
    font-style: normal;
  }

  /* ============================================================
     BOTTOM ROW
     ============================================================ */

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid color-mix(in srgb, var(--color-text-inverse) 12%, transparent);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--color-text-inverse) 40%, transparent);
    margin: 0;
  }

  .footer__legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-m);
  }

  .footer__legal-link {
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--color-text-inverse) 40%, transparent);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__legal-link:hover {
    color: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
  }

  .footer__legal-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color-inverse);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }
</style>
