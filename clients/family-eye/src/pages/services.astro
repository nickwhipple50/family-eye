---
/**
 * pages/services.astro
 * Health & Wellness kit — Services page
 *
 * Sections:
 *   1. Hero         — centered
 *   2. ServiceList  — grid-icon, 2 col, full descriptions with duration + price
 *   3. ProcessSteps — what a first session looks like
 *   4. CTABand      — "Book your first session"
 *
 * ProcessSteps purpose:
 *   New clients in wellness contexts often have anxiety about what to
 *   expect — especially for bodywork or hands-on treatments. Walking
 *   through the process ("what happens when I arrive", "what do I wear",
 *   "what happens during the session") reduces that friction significantly.
 *   Kit author: replace these steps with the client's actual intake process.
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, ServiceList, ProcessSteps, CTABand, FeatureGrid } from '@mmm/components';
---

<Layout
  title='Services'
  description='Explore our full range of wellness services — massage therapy, bodywork, and more. Every session is tailored to what your body needs.'
  breadcrumbs={[{ label: 'Services', href: '/services' }]}
>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO -->
    <Hero
      variant='centered'
      heading='Eye Exams & Eyewear Studio'
      body='We provide modern and comfortable eye care with a personal touch.  All of our eyewear and contact lenses are the newest and best technology in optics.  We are a locally owned small business with doctors that grew up here and are your neighbors.'
      cta={{ label: 'Book a session', href: '/contact' }}
      secondaryCta={{ label: 'Read our FAQ', href: '/faq' }}
    />

    <!-- ② SERVICE LIST — 2 col with duration and price -->
    <ServiceList
      heading='Eye exams do more than test your vision'
      body='At Family Eye Health Associates we practice to the highest standards of medical optometry with a commitment to both your ocular and systemic health.'
      variant='grid-icon'
      columns={2}
      surface='base'
      items={[
        {
          name: 'Systemic wellness',
          description:
            'Many systemic conditions can be detected or observed during an eye exam such as diabetes, hypertension, high cholesterol, carotid artery disease, multiple sclerosis, heart disease, brain tumors, and thyroid disease. Make an annual eye exam part of your total wellness plan.',
        },
        {
          name: 'Contact lenses',
          description:
            "We provide comprehensive contact lens care for all of our patients. From daily disposable contacts to custom made lenses for eye disease such as keratoconus, we can fit just about anyone's eyes!",
        },
        {
          name: 'Vision therapy',
          description:
            "When our eyes don't work well as a team, it can affect our work or school performance. Our doctors are trained to detect these problems and create a customized solution for your needs — whether it's glasses or a vision therapy program to enhance the way your eyes work together and optimize your visual potential.",
        },
        {
          name: 'Pediatric exams',
          description:
            "While our pediatrician colleagues do a fantastic job at finding major vision problems in children, our doctors are trained in uncovering subtle vision problems that may be affecting your child's life and schoolwork. We recommend a complete eye exam by kindergarten.",
        },
        {
          name: 'Glaucoma and macula degeneration',
          description:
            'Glaucoma and macula degeneration are the silent destroyers of our vision. By the time you notice symptoms, there is usually some degree of permanent vision loss. Our doctors are trained in the detection and treatment of these potentially blinding diseases.',
        },
        {
          name: 'Cataracts',
          description:
            "A cataract is a haze that forms within our eye's natural lens as we age. It is a normal part of getting older for all of us. Our doctors look for cataracts during your eye exam and provide complete pre- and post-operative care with several of the best cataract surgeons in the state.",
        },
      ]}
    />

    <FeatureGrid
      heading='Glasses for every member of the family'
      body="The Eyewear Studio at Family Eye Health Associates has something for every style and budget. Styles for adults and children. Men's, women's and unisex styles. Metal or plastic. Fashion or basic. We have a frame for you. We also repair and adjust glasses. From replacing a lost screw to straightening bent frames, we can take care of it, no appointment necessary!"
      variant='cards'
      surface='subtle'
      columns={3}
      items={[
        {
          icon: 'glasses',
          heading: 'Standard lenses',
          body: 'All of our premium eyewear comes standard with Crizal lenses. Crizal offers a complete line of lens enhancements that protect against glare, scratches, and smudges and block potentially harmful blue light from digital devices.',
        },
        {
          icon: 'scan-eye',
          heading: 'Progressive lenses',
          body: 'We use Varilux lenses as our standard progressive lenses for our patients who need glasses for both distance and near. Varilux lenses utilize technology that gives you the clearest, sharpest vision you have ever experienced with no-line bifocals.',
        },
        {
          icon: 'sun-moon',
          heading: 'Transition lenses',
          body: 'We proudly offer Transitions Light Intelligent Lenses to fit every lifestyle and every age. Not only do they adjust from fully clear indoors to the perfect tint outdoors, but they also block dangerous UV rays and filter blue light, which can be found outdoors and from digital devices.',
        },
      ]}
    />
    <!-- ③ PROCESS STEPS — what to expect at your first visit -->
    <div
      id='first-visit'
      style='scroll-margin-top: var(--nav-height)'
    >
      <ProcessSteps
        heading='What to expect at your first visit'
        body="First visits can feel unfamiliar. Here's exactly what happens, so you can arrive relaxed."
        variant='numbered'
        layout='horizontal'
        surface='base'
        items={[
          {
            title: 'Request your appointment',
            body: "Use the form on our Contact page or call us directly. We'll follow up within one business day to confirm a time. ",
          },
          {
            title: 'Complete your intake',
            body: 'Download and fill out our intake form, which covers health history, current medications, and insurance information. Completing it ahead of time helps your first appointment go smoothly.',
          },
          {
            title: 'Your first visit',
            body: 'At your first visit with us we will take our time to get to know you.  We want to feel welcome and comfortable as we strive to understand your visual needs.  You will have a comprehensive eye exam that looks at your total vision needs and eye health.  We will take the time to address all of your vision and eye concerns.',
          },
          {
            title: 'After your visit',
            body: "We recommend annual exams, but we are here for you year-round.  Whether it's just standing by our eyewear, following-up for other eye conditions, or being there for you for emergency eye problems, you can count on us to always be available to you.",
          },
        ]}
      />
    </div>

    <!-- ④ CTA BAND -->
    <CTABand
      heading='Ready to become a patient?'
      body="We're accepting new patients of all ages. Request an appointment online and we'll confirm within one business day."
      primaryCta={{ label: 'Book a session', href: '/contact' }}
      secondaryCta={{ label: 'Read our FAQ', href: '/faq' }}
    />
  </main>
</Layout>
