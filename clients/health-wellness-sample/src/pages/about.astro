---
/**
 * pages/about.astro
 * Health & Wellness kit — About page
 *
 * Sections:
 *   1. Hero          — split, practitioner photo — trust is personal here
 *   2. FeatureGrid   — philosophy, approach, credentials, why this practice
 *   3. TeamGrid      — solo or multi-practitioner
 *   4. TestimonialRow — client stories reinforce the personal connection
 *   5. CTABand
 *
 * Note: In wellness, clients are choosing a person more than a service.
 * The practitioner photo in the hero is important — a real, warm photo
 * of the actual practitioner outperforms any other image on this page.
 * Push back on launching with a stock photo here.
 *
 * The FeatureGrid should reflect real values and approach — not generic
 * wellness language. What does this practitioner actually believe about
 * the body? What's their method? Why did they enter this field?
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, FeatureGrid, TeamGrid, TestimonialRow, CTABand } from '@mmm/components';
import { getCollection } from 'astro:content';

const team = await getCollection('team');
const testimonials = await getCollection('testimonials');
const settings = (await getCollection('site_settings'))[0]?.data;

const sortedTeam = team
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((m) => m.data);

const sortedTestimonials = testimonials
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((t) => t.data);

const featuredIndex = Math.max(
  0,
  sortedTestimonials.findIndex((t) => t.featured)
);

const siteName = settings?.site_name ?? 'us';
---

<Layout
  title='About'
  description={`Meet the practitioners at ${siteName} — trained, licensed, and genuinely invested in your wellbeing.`}
  breadcrumbs={[{ label: 'About', href: '/about' }]}
>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO — split, warm practitioner photo -->
    <Hero
      variant='split'
      heading='A small practice that takes its time'
      body='Coastal Family Medicine opened in Narragansett because South County deserved a primary care option that felt like a practice — not a processing center. We see fewer patients so we can do the job properly.'
      cta={{ label: 'Meet Dr. Hartnett', href: '#team' }}
      secondaryCta={{ label: 'Request an appointment', href: '/contact' }}
      image={{
        src: '/images/about-lead-practitioner-in-treatment-room.jpeg',
        alt: 'Dr. Hartnett in the treatment room',
      }}
    />

    <!-- ② FEATURE GRID — philosophy and approach -->
    <FeatureGrid
      heading='How I approach the work'
      variant='plain'
      columns={3}
      surface='subtle'
      items={[
        {
          icon: 'ear',
          heading: 'We listen before we conclude',
          body: "Your history and your symptoms together tell a more complete story than either one alone. We don't walk in with a diagnosis already written.",
        },
        {
          icon: 'message',
          heading: 'We explain what we find',
          body: "What we see, what it means, and what we recommend — in plain language. If you leave confused, we haven't done our job.",
        },
        {
          icon: 'clock',
          heading: "We don't rush appointments",
          body: 'Your appointment time is yours. We keep our patient volume manageable so no one is moved through in 7 minutes.',
        },
        {
          icon: 'x-circle',
          heading: "We don't overtreat",
          body: "We don't order tests to cover ourselves. If watchful waiting is the right call, we'll say so and explain why.",
        },
        {
          icon: 'phone',
          heading: 'We return calls same-day',
          body: "If you call with a concern, you'll hear back before the end of the day. A doctor who's hard to reach isn't much use.",
        },
        {
          icon: 'map-pin',
          heading: "We're part of this community",
          body: "Dr. Hartnett grew up in South Kingstown. This isn't a regional chain with rotating staff — it's a practice that knows its patients by name.",
        },
      ]}
    />

    <!-- ③ TEAM GRID -->
    {
      sortedTeam.length > 0 && (
        <div
          id='team'
          style='scroll-margin-top: var(--nav-height)'
        >
          <TeamGrid
            heading={sortedTeam.length === 1 ? 'Your practitioner' : 'Our staff'}
            columns={3}
            surface='base'
            items={sortedTeam}
          />
        </div>
      )
    }

    <!-- ④ TESTIMONIALS -->
    {
      sortedTestimonials.length > 0 && (
        <TestimonialRow
          heading='In their own words'
          variant='cards'
          surface='subtle'
          featuredIndex={featuredIndex}
          items={sortedTestimonials}
        />
      )
    }

    <!-- ⑤ CTA BAND -->
    <CTABand
      heading='Ready to work together?'
      body="New clients are always welcome. Book online or send a message if you'd like to talk first."
      primaryCta={{ label: 'Book a session', href: '/contact' }}
      secondaryCta={{ label: 'See our services', href: '/services' }}
    />
  </main>
</Layout>
