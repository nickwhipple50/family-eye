---
/**
 * pages/services.astro
 * Health & Wellness kit — Services page
 *
 * Sections:
 *   1. Hero         — centered
 *   2. ServiceList  — grid-icon, 2 col, full descriptions with duration + price
 *   3. ProcessSteps — what a first session looks like
 *   4. CTABand      — "Book your first session"
 *
 * ProcessSteps purpose:
 *   New clients in wellness contexts often have anxiety about what to
 *   expect — especially for bodywork or hands-on treatments. Walking
 *   through the process ("what happens when I arrive", "what do I wear",
 *   "what happens during the session") reduces that friction significantly.
 *   Kit author: replace these steps with the client's actual intake process.
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, ServiceList, ProcessSteps, CTABand } from '@mmm/components';
import { getCollection } from 'astro:content';

const services = await getCollection('services');

const sortedServices = services
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((s) => s.data);
---

<Layout
  title='Services'
  description='Explore our full range of wellness services — massage therapy, bodywork, and more. Every session is tailored to what your body needs.'
  breadcrumbs={[{ label: 'Services', href: '/services' }]}
>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO -->
    <Hero
      variant='centered'
      heading='What we treat'
      body="We provide primary care for patients of all ages — from annual physicals to management of ongoing conditions. If something's outside our scope, we'll refer you to the right specialist and stay involved."
      cta={{ label: 'Request an appointment', href: '/contact' }}
      secondaryCta={{ label: 'Read our FAQ', href: '/faq' }}
    />

    <!-- ② SERVICE LIST — 2 col with duration and price -->
    {
      sortedServices.length > 0 && (
        <ServiceList
          heading='What we offer'
          variant='grid-icon'
          columns={2}
          surface='subtle'
          items={sortedServices}
        />
      )
    }

    <!-- ③ PROCESS STEPS — what to expect at your first visit -->
    <div
      id='first-visit'
      style='scroll-margin-top: var(--nav-height)'
    >
      <ProcessSteps
        heading='What to expect at your first visit'
        body="First visits can feel unfamiliar. Here's exactly what happens — so you can arrive relaxed."
        variant='numbered'
        layout='horizontal'
        surface='base'
        items={[
          {
            title: 'Request your appointment',
            body: "Use the form on our Contact page or call us directly. We'll follow up within one business day to confirm a time. Same-week availability is kept open for sick visits.",
          },
          {
            title: 'Complete your intake',
            body: "We'll send a short intake form before your visit — health history, current medications, and insurance information. Completing it ahead of time means your appointment time is spent on you, not paperwork.",
          },
          {
            title: 'Your first visit',
            body: "Dr. Hartnett will review your history, talk through what brought you in, and complete a physical exam. First visits run a little longer — plan for about 45 minutes. There's no rushing.",
          },
          {
            title: 'A plan you understand',
            body: "Before you leave, we'll explain what we found, what we recommend, and why. If you need follow-up, referrals, or labs, those are ordered before you go — not left to a phone call.",
          },
        ]}
      />
    </div>

    <!-- ④ CTA BAND -->
    <CTABand
      heading='Ready to become a patient?'
      body="We're accepting new patients of all ages. Request an appointment online and we'll confirm within one business day."
      primaryCta={{ label: 'Book a session', href: '/contact' }}
      secondaryCta={{ label: 'Read our FAQ', href: '/faq' }}
    />
  </main>
</Layout>
