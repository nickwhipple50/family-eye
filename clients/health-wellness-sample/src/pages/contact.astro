---
/**
 * pages/contact.astro
 * Health & Wellness kit — Contact + Book page
 *
 * Sections:
 *   1. Hero         — centered, warm and low-pressure
 *   2. Contact section — booking form + contact details (no map)
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, ContactForm } from '@mmm/components';
import { getCollection } from 'astro:content';

const settings = (await getCollection('site_settings'))[0]?.data;
const contact = settings?.contact;
const siteName = settings?.site_name ?? 'us';
---

<Layout
  title='Book a session'
  description={`Book your session at ${siteName}. New clients welcome — simple online booking, we'll confirm within a few hours.`}
  breadcrumbs={[{ label: 'Book', href: '/contact' }]}
>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO — warm, low-pressure -->
    <Hero
      variant='centered'
      heading="Let's get you booked"
      body="Fill in the form and we'll follow up within one business day to confirm your visit. For urgent concerns, please call us directly at (401) 555-1082."
      cta={{ label: 'Jump to booking form', href: '#booking-form' }}
    />

    <!-- ② BOOKING SECTION -->
    <!--
      Kit author: if the client uses a booking platform (MindBody, Acuity,
      Jane App, etc.) replace the ContactForm below with their embed code.
      Keep the surrounding section markup and heading — just swap the form.
    -->
    <section
      class='contact-page section surface-base'
      aria-label='Booking form and contact details'
    >
      <div class='contact-page__inner section__inner'>
        <!-- LEFT — booking form -->
        <div
          id='booking-form'
          style='scroll-margin-top: var(--nav-height)'
        >
          <ContactForm
            heading='Book or get in touch'
            body='We respond to all requests within one business day. For sick visits, call us directly — same-week appointments are available.'
            action='/contact'
            submitLabel='Send my request'
            fields={[
              {
                name: 'first_name',
                label: 'First name',
                type: 'text',
                required: true,
                width: 'half',
                autocomplete: 'given-name',
              },
              {
                name: 'last_name',
                label: 'Last name',
                type: 'text',
                required: true,
                width: 'half',
                autocomplete: 'family-name',
              },
              {
                name: 'phone',
                label: 'Phone number',
                type: 'tel',
                required: false,
                width: 'half',
                autocomplete: 'tel',
              },
              {
                name: 'email',
                label: 'Email address',
                type: 'email',
                required: true,
                width: 'full',
                autocomplete: 'email',
              },
              {
                name: 'insurance',
                label: 'Insurance provider',
                type: 'text',
                required: false,
                width: 'full',
                placeholder: 'e.g. Blue Cross Blue Shield of RI',
              },
              {
                name: 'visit_type',
                label: 'What type of visit are you requesting?',
                type: 'select',
                required: false,
                options: [
                  'New patient exam',
                  'Annual wellness visit',
                  'Sick visit',
                  'Follow-up appointment',
                  'Telehealth visit',
                  "I'm not sure — help me choose",
                ],
              },
              {
                name: 'preferred_days',
                label: 'Preferred days',
                type: 'checkbox-group',
                width: 'full',
                options: ['Monday–Friday', 'Saturday morning'],
              },
              {
                name: 'preferred_time',
                label: 'Preferred time of day',
                type: 'checkbox-group',
                width: 'full',
                options: ['Morning (8am–12pm)', 'Afternoon (12pm–5pm)'],
              },
              {
                name: 'message',
                label: 'Anything else we should know?',
                type: 'textarea',
                required: false,
                placeholder:
                  'Current medications, conditions, reason for visit, or any questions — anything that helps us prepare for your visit.',
              },
              {
                name: 'consent',
                label:
                  'I agree to be contacted about my inquiry. Your information is kept private and never shared.',
                type: 'checkbox',
                required: true,
              },
            ]}
          />
        </div>

        <!-- RIGHT — contact details and reassurance -->
        <aside
          class='contact-page__details'
          aria-label='Contact details'
        >
          <!-- Reassurance block -->
          <div class='contact-page__reassurance'>
            <h2 class='contact-page__reassurance-heading'>What happens next</h2>
            <ol class='contact-page__steps'>
              <li class='contact-page__step'>
                <span class='contact-page__step-number'>01</span>
                <span class='contact-page__step-text'>
                  We receive your request and follow up within one business day to confirm your
                  appointment.
                </span>
              </li>
              <li class='contact-page__step'>
                <span class='contact-page__step-number'>02</span>
                <span class='contact-page__step-text'>
                  Before your visit, we'll send a short intake form - health history, medications,
                  and insurance information.
                </span>
              </li>
              <li class='contact-page__step'>
                <span class='contact-page__step-number'>03</span>
                <span class='contact-page__step-text'>
                  Arrive 10-15 minutes early on your first visit. Your appointment time is yours
                  from there.
                </span>
              </li>
            </ol>
          </div>

          <!-- Contact details -->
          <dl class='contact-page__info'>
            {
              contact?.phone && (
                <>
                  <dt class='contact-page__info-label'>Phone</dt>
                  <dd class='contact-page__info-value'>
                    <a
                      href={`tel:${contact.phone.replace(/\D/g, '')}`}
                      class='contact-page__link'
                    >
                      {contact.phone}
                    </a>
                  </dd>
                </>
              )
            }
            {
              contact?.email && (
                <>
                  <dt class='contact-page__info-label'>Email</dt>
                  <dd class='contact-page__info-value'>
                    <a
                      href={`mailto:${contact.email}`}
                      class='contact-page__link'
                    >
                      {contact.email}
                    </a>
                  </dd>
                </>
              )
            }
            {
              contact?.address && (
                <>
                  <dt class='contact-page__info-label'>Address</dt>
                  <dd class='contact-page__info-value'>
                    <address>{contact.address}</address>
                  </dd>
                </>
              )
            }
            {
              contact?.service_area && (
                <>
                  <dt class='contact-page__info-label'>Parking</dt>
                  <dd class='contact-page__info-value'>{contact.service_area}</dd>
                </>
              )
            }
          </dl>

          <!-- Gentle privacy note -->
          <p class='contact-page__privacy'>
            Your information is kept private. We only use it to confirm your booking and follow up
            on your inquiry.
          </p>
        </aside>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-page__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-page__inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .contact-page__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ============================================================
     REASSURANCE BLOCK
     ============================================================ */

  .contact-page__reassurance {
    padding: var(--space-l);
    background-color: var(--color-surface-subtle);
    border-radius: var(--card-radius);
    border-inline-start: 3px solid var(--color-primary);
  }

  .contact-page__reassurance-heading {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-heading, var(--font-weight-bold));
    color: var(--color-text-heading);
    margin: 0 0 var(--space-m);
  }

  .contact-page__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .contact-page__step {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-s);
    align-items: baseline;
  }

  .contact-page__step-number {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    letter-spacing: var(--tracking-wide);
  }

  .contact-page__step-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-base);
  }

  /* ============================================================
     CONTACT INFO
     ============================================================ */

  .contact-page__info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-m);
    align-items: baseline;
    margin: 0;
    padding: 0;
  }

  .contact-page__info-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .contact-page__info-value {
    font-size: var(--text-sm);
    color: var(--color-text-base);
    margin: 0;
  }

  .contact-page__info-value address {
    font-style: normal;
  }

  .contact-page__link {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .contact-page__link:hover {
    color: var(--color-primary-dark);
  }

  /* ============================================================
     PRIVACY NOTE
     ============================================================ */

  .contact-page__privacy {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-subtle);
    margin: 0;
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--color-border);
  }
</style>
