---
/**
 * pages/index.astro
 * Health & Wellness kit — Home page
 *
 * Sections:
 *   1. Hero        — split, practitioner with client or calming space
 *   2. StatsRow    — years in practice, clients helped, services, rating
 *   3. ServiceList — grid-icon, what they offer
 *   4. TestimonialRow — client experiences
 *   5. CTABand     — "Book a session"
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, StatsRow, ServiceList, TestimonialRow, CTABand } from '@mmm/components';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const testimonials = await getCollection('testimonials');
const settings = (await getCollection('site_settings'))[0]?.data;

const sortedServices = services
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 6)
  .map((s) => s.data);

const sortedTestimonials = testimonials
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3)
  .map((t) => t.data);
---

<Layout description={settings?.seo?.description}>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO — split, warm and welcoming -->
    <Hero
      variant='split'
      heading="Your family's doctor, when you actually need one."
      body='Coastal Family Medicine provides primary care for patients of all ages in Narragansett and South County. We keep same-week appointments available, return calls the same day, and take the time to explain what we find.'
      cta={{ label: 'Request an appointment', href: '/contact' }}
      secondaryCta={{ label: 'See our services', href: '/services' }}
      image={{
        src: '/images/lead-practicioner-in-treatment-room.jpeg',
        alt: 'Dr. Hartnett with a patient at Coastal Family Medicine',
      }}
    />

    <!-- ② STATS ROW — gentle, not salesy -->
    <StatsRow
      variant='band'
      surface='inverse'
      items={[
        { value: 200, suffix: '+', label: 'active patients' },
        { value: 15, suffix: '+', label: 'years in practice' },
        { value: 4.9, suffix: '★', label: 'average rating', decimals: 1 },
      ]}
    />

    <!-- ③ SERVICE LIST -->
    {
      sortedServices.length > 0 && (
        <ServiceList
          heading='Primary care for the whole family'
          body='Annual physicals to chronic condition management, all under one roof.'
          variant='grid-icon'
          columns={3}
          surface='subtle'
          items={sortedServices}
        />
      )
    }

    <!-- ④ TESTIMONIALS — client experiences -->
    {
      sortedTestimonials.length > 0 && (
        <TestimonialRow
          heading='What our patients say'
          variant='cards'
          columns={3}
          surface='base'
          items={sortedTestimonials}
        />
      )
    }

    <!-- ⑤ CTA BAND — warm, no pressure -->
    <CTABand
      heading='Accepting new patients in South County.'
      body="Request an appointment online and we'll follow up within one business day. Same-week availability for sick visits."
      eyebrow='Get started'
      primaryCta={{ label: 'Request an appointment', href: '/contact' }}
      secondaryCta={{ label: 'Read our FAQ', href: '/faq' }}
    />
  </main>
</Layout>
