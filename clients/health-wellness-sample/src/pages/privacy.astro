---
import ProseLayout from '../layouts/ProseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'privacy');

// Fallback if CMS entry doesn't exist yet
const title = entry?.data?.title ?? 'Privacy Policy';
const body = entry?.data?.body ?? '<p>Privacy policy coming soon.</p>';
const updated = entry?.data?.updated_at ?? null;
---

<ProseLayout
  title={title}
  description={`${title} — read about how we handle your data.`}
>
  <h1>{title}</h1>

  {
    updated && (
      <p style='color: var(--color-text-subtle); font-size: var(--text-sm); margin-block-end: var(--space-xl);'>
        Last updated:{' '}
        <time datetime={updated}>
          {new Date(updated).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>
      </p>
    )
  }

  <div set:html={body} />
</ProseLayout>
