---
/**
 * Hero
 * Page hero — first section, above the fold. Three layout variants.
 *
 * Props (max 6 — T1 rule):
 *   heading      string                              required
 *   body         string?                             Supporting paragraph — 1–2 sentences
 *   cta          { label: string; href: string }     required
 *   secondaryCta { label: string; href: string }?    Optional ghost button
 *   variant      'centered' | 'split' | 'fullbleed'  default: 'centered'
 *   image        { src: string; alt: string }?       Required for split + fullbleed.
 *                                                    Ignored for centered.
 *                                                    Split: content + image side-by-side.
 *                                                    Fullbleed: image fills background.
 *
 * Variants:
 *   centered   — text centred, no image, suits most kits as default
 *   split      — text left / image right, 50/50 at desktop, stacked mobile
 *   fullbleed  — image fills section, dark overlay, text centred over it
 *
 * Kit defaults (set in page template, junior never changes the component):
 *   Service business      → centered
 *   Professional services → split
 *   Health & wellness     → centered or split
 *   Restaurant            → fullbleed
 *   Real estate           → fullbleed or split
 *   Personal brand        → split
 *   SaaS / startup        → centered
 *
 * Notes:
 *   — image.src should be a URL string — either a /public path or a CMS media URL.
 *     The kit page template is responsible for resolving local asset imports before
 *     passing them in. The shared library does not import from astro:assets.
 *   — The nav sits above this section and is transparent at load (frosted glass on scroll).
 *     Hero adds padding-block-start to clear the nav height.
 *   — No data-reveal on the hero itself — it's above the fold and should render immediately.
 *     Children animate in via CSS on load instead.
 */

interface ImageProp {
  src: string;
  alt: string;
}

interface CtaProp {
  label: string;
  href: string;
}

interface Props {
  heading: string;
  body?: string;
  cta: CtaProp;
  secondaryCta?: CtaProp;
  variant?: 'centered' | 'split' | 'fullbleed';
  image?: ImageProp;
}

const { heading, body, cta, secondaryCta, variant = 'centered', image } = Astro.props;

const needsImage = variant === 'split' || variant === 'fullbleed';

if (needsImage && !image) {
  console.warn(
    `[Hero] variant="${variant}" requires an image prop. Falling back to centered layout.`
  );
}

// Use the intended variant only if image is present when required
const resolvedVariant = needsImage && !image ? 'centered' : variant;
---

<section
  class={`hero hero--${resolvedVariant}`}
  aria-labelledby='hero-heading'
>
  {/* Fullbleed background image */}
  {
    resolvedVariant === 'fullbleed' && image && (
      <div
        class='hero__bg'
        aria-hidden='true'
      >
        <img
          src={image.src}
          alt=''
          width={1920}
          height={1080}
          loading='eager'
          fetchpriority='high'
          decoding='async'
          class='hero__bg-img'
        />
        <div class='hero__overlay' />
      </div>
    )
  }

  {/* Mesh gradient — centered + split variants only */}
  {
    resolvedVariant !== 'fullbleed' && (
      <div
        class='hero__mesh'
        aria-hidden='true'
      />
    )
  }

  <div class='hero__inner'>
    {/* Content block — present in all variants */}
    <div class='hero__content'>
      <h1
        class='hero__heading'
        id='hero-heading'
      >
        {heading}
      </h1>

      {body && <p class='hero__body'>{body}</p>}

      <div class='hero__actions'>
        <a
          href={cta.href}
          class='btn btn--primary'
        >
          {cta.label}
        </a>

        {
          secondaryCta && (
            <a
              href={secondaryCta.href}
              class={`btn ${resolvedVariant === 'fullbleed' ? 'btn--ghost-inverse' : 'btn--ghost'}`}
            >
              {secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>

    {/* Split image — right column */}
    {
      resolvedVariant === 'split' && image && (
        <div class='hero__media'>
          <img
            src={image.src}
            alt={image.alt}
            width={800}
            height={900}
            loading='eager'
            fetchpriority='high'
            decoding='async'
            class='hero__img'
          />
        </div>
      )
    }
  </div>
</section>

<style>
  /* ============================================================
     BASE — shared across all variants
     ============================================================ */

  .hero {
    position: relative;
    overflow: hidden;
    min-height: var(--hero-min-height);
    padding-block-start: calc(var(--nav-height) + var(--space-xl));
    padding-block-end: var(--space-xl);
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--max-width-content);
    margin-inline: auto;
  }

  /* ============================================================
     CENTERED VARIANT
     ============================================================ */

  .hero--centered .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero--centered .hero__content {
    max-width: var(--hero-content-max);
  }

  /* Mesh gradient — decorative, centered behind content */
  .hero__mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse at 30% 40%, var(--color-mesh-a) 0%, transparent 55%),
      radial-gradient(ellipse at 70% 60%, var(--color-mesh-b) 0%, transparent 55%);
  }

  /* ============================================================
     SPLIT VARIANT — text left / image right
     ============================================================ */

  .hero--split .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l-xl);
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero--split .hero__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero--split .hero__media {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    /* Slight aspect ratio hint on mobile before grid kicks in */
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 768px) {
    .hero--split .hero__media {
      aspect-ratio: unset;
      /* Let image height drive the row */
    }
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ============================================================
     FULLBLEED VARIANT — image fills section
     ============================================================ */

  .hero--fullbleed {
    /* Ensure text is readable over any image */
    color: var(--color-text-inverse);
  }

  .hero--fullbleed .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero--fullbleed .hero__content {
    max-width: var(--hero-content-max);
  }

  /* Background image layer */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Dark overlay — ensures text contrast over any image */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-surface-inverse) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-surface-inverse) 70%, transparent) 100%
    );
  }

  /* ============================================================
     TYPOGRAPHY — shared
     ============================================================ */

  .hero__heading {
    font-family: var(--font-heading);
    font-size: var(--text-display);
    font-weight: var(--font-weight-heading, var(--font-weight-bold));
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-heading);
    margin: 0 0 var(--space-m);
  }

  .hero--fullbleed .hero__heading {
    color: var(--color-text-inverse);
  }

  .hero__body {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-l);
    max-width: var(--measure-default);
  }

  .hero--centered .hero__body,
  .hero--fullbleed .hero__body {
    /* Keep prose centred and readable */
    margin-inline: auto;
  }

  .hero--fullbleed .hero__body {
    color: color-mix(in srgb, var(--color-text-inverse) 80%, transparent);
  }

  /* ============================================================
     ACTIONS
     ============================================================ */

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .hero--centered .hero__actions,
  .hero--fullbleed .hero__actions {
    justify-content: center;
  }

  /* ============================================================
     BUTTONS
     Base .btn defined here until globals.css exists.
     Inverse variants needed only for fullbleed — same pattern as CTABand.
     ============================================================ */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--btn-padding-y-lg);
    padding-inline: var(--btn-padding-x-lg);
    font-family: var(--font-body);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    line-height: 1;
    border-radius: var(--btn-radius);
    text-decoration: none;
    transition: var(--btn-transition);
    cursor: pointer;
    white-space: nowrap;
    border: 2px solid transparent;
  }

  /* Primary — accent fill */
  .btn--primary {
    background-color: var(--color-accent);
    color: var(--color-text-inverse);
    border-color: var(--color-accent);
  }

  .btn--primary:hover {
    background-color: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Ghost — transparent, primary border */
  .btn--ghost {
    background-color: transparent;
    color: var(--color-primary);
    border-color: var(--color-border-strong);
  }

  .btn--ghost:hover {
    border-color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 6%, transparent);
    transform: translateY(-2px);
  }

  /* Ghost inverse — for fullbleed hero over dark background */
  .btn--ghost-inverse {
    background-color: transparent;
    color: var(--color-text-inverse);
    border-color: color-mix(in srgb, var(--color-text-inverse) 40%, transparent);
  }

  .btn--ghost-inverse:hover {
    border-color: var(--color-text-inverse);
    background-color: color-mix(in srgb, var(--color-text-inverse) 10%, transparent);
    transform: translateY(-2px);
  }

  /* ============================================================
     LOAD ANIMATION
     Hero is above the fold — no IntersectionObserver.
     Children animate in on load via CSS animation.
     Stagger via animation-delay, driven by nth-child.
     prefers-reduced-motion handled by token collapse.
     ============================================================ */

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__heading,
  .hero__body,
  .hero__actions,
  .hero__media {
    animation: hero-rise var(--reveal-duration) var(--reveal-ease) both;
  }

  .hero__heading {
    animation-delay: 0ms;
  }
  .hero__body {
    animation-delay: calc(var(--reveal-stagger) * 1);
  }
  .hero__actions {
    animation-delay: calc(var(--reveal-stagger) * 2);
  }
  .hero__media {
    animation-delay: calc(var(--reveal-stagger) * 3);
  }
</style>
