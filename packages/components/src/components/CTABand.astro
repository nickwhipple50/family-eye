---
/**
 * CTABand
 * Full-width call-to-action strip. Dark surface, centred content, one or two buttons.
 *
 * Props (max 6 — T1 rule):
 *   heading    string   required  Main CTA headline
 *   body       string?           Supporting sentence — keep to one line
 *   primaryCta  { label, href }  required  Primary button
 *   secondaryCta { label, href }?          Secondary ghost button
 *   eyebrow    string?           Small label above heading
 *   variant    'default' | 'accent'        default = primary surface / accent = accent surface
 *
 * Usage:
 *   <CTABand
 *     heading="Ready to get started?"
 *     body="No contracts. No setup fees. Cancel any time."
 *     primaryCta={{ label: "Book a free call", href: "/contact" }}
 *     secondaryCta={{ label: "See our work", href: "/work" }}
 *     eyebrow="Let's talk"
 *   />
 */

interface Props {
  heading: string;
  body?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  eyebrow?: string;
  variant?: 'default' | 'accent';
}

const { heading, body, primaryCta, secondaryCta, eyebrow, variant = 'default' } = Astro.props;
---

<section
  class={`cta-band cta-band--${variant} has-noise`}
  aria-label={heading}
>
  <div class='cta-band__inner'>
    {
      eyebrow && (
        <p
          class='cta-band__eyebrow'
          data-reveal
          style='--item-index: 0'
        >
          {eyebrow}
        </p>
      )
    }

    <h2
      class='cta-band__heading'
      data-reveal
      style={`--item-index: ${eyebrow ? 1 : 0}`}
    >
      {heading}
    </h2>

    {
      body && (
        <p
          class='cta-band__body'
          data-reveal
          style={`--item-index: ${eyebrow ? 2 : 1}`}
        >
          {body}
        </p>
      )
    }

    {
      !secondaryCta && (
        <div
          class='cta-band__actions'
          data-reveal
          style={`--item-index: ${eyebrow ? 3 : 2}`}
        >
          <a
            href={primaryCta.href}
            class='btn btn--primary-inverse'
          >
            {primaryCta.label}
          </a>
        </div>
      )
    }

    {
      secondaryCta && (
        <nav
          class='cta-band__actions'
          aria-label='Call to action'
          data-reveal
          style={`--item-index: ${eyebrow ? 3 : 2}`}
        >
          <a
            href={primaryCta.href}
            class='btn btn--primary-inverse'
          >
            {primaryCta.label}
          </a>
          <a
            href={secondaryCta.href}
            class='btn btn--ghost-inverse'
          >
            {secondaryCta.label}
          </a>
        </nav>
      )
    }
  </div>
</section>

<style>
  /* ============================================================
     LAYOUT
     CTABand is always inverse surface — not using .section / .surface-*
     globals because it has its own padding token and is always dark.
     ============================================================ */

  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: var(--cta-band-pad-y);
    padding-inline: var(--gutter);
    text-align: center;
    background-color: var(--color-surface-inverse);
    background-image:
      radial-gradient(ellipse at 20% 50%, var(--color-mesh-a) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 50%, var(--color-mesh-b) 0%, transparent 60%);
  }

  .cta-band--accent {
    background-color: var(--color-accent);
    background-image:
      radial-gradient(
        ellipse at 20% 50%,
        color-mix(in srgb, var(--color-accent-light) 40%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse at 80% 50%,
        color-mix(in srgb, var(--color-accent-dark) 40%, transparent) 0%,
        transparent 60%
      );
  }

  /* ============================================================
     INNER
     position: relative + z-index: 1 handled by .has-noise > * in globals.
     ============================================================ */

  .cta-band__inner {
    max-width: var(--max-width-narrow);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }

  /* ============================================================
     TYPOGRAPHY
     ============================================================ */

  .cta-band__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent-light);
    margin: 0;
  }

  .cta-band--accent .cta-band__eyebrow {
    color: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
  }

  .cta-band__heading {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--font-weight-heading, var(--font-weight-bold));
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-inverse);
    margin: 0;
    max-width: 20ch;
  }

  .cta-band__body {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: color-mix(in srgb, var(--color-text-inverse) 75%, transparent);
    margin: 0;
    max-width: var(--measure-narrow);
  }

  /* ============================================================
     ACTIONS
     ============================================================ */

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
    margin-block-start: var(--space-xs);
  }

  /* Accent variant button override */
  .cta-band--accent .btn--primary-inverse {
    color: var(--color-accent-dark);
  }
</style>
