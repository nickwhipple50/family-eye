---
/**
 * pages/reviews.astro
 * Service Business kit — Reviews page
 *
 * Sections:
 *   1. Hero — centered
 *   2. TestimonialRow — cards, all reviews
 *   3. LogoBar — accreditation logos (review platforms, trade bodies)
 *   4. CTABand
 *
 * Note: t1.md flags Reviews as the primary trust conversion lever
 * for the service-business kit. This page deserves real customer
 * quotes — not placeholder text. Push back on launching without them.
 */

import Layout from '../layouts/KitLayout.astro';
import {
  Hero,
  TestimonialRow,
  LogoBar,
  CTABand,
} from '@mmm/components';
import { getCollection, getEntry } from 'astro:content';

const testimonials = await getCollection('testimonials');
const settings     = (await getEntry('site_settings', 'general'))?.data;

const sortedTestimonials = testimonials
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map(t => t.data);

// Aggregate rating for hero — computed from CMS data at build time
const rated = sortedTestimonials.filter(t => t.rating);
const avgRating = rated.length
  ? (rated.reduce((sum, t) => sum + (t.rating ?? 0), 0) / rated.length).toFixed(1)
  : null;
---

<Layout
  title="Customer reviews"
  description={`See what our customers say about us${avgRating ? ` — rated ${avgRating} out of 5` : ''}.`}
  breadcrumbs={[{ label: 'Reviews', href: '/reviews' }]}
>
  <main id="main-content" tabindex="-1">

    <!-- ① HERO — centered, social proof headline -->
    <Hero
      variant="centered"
      heading={avgRating
        ? `Rated ${avgRating} out of 5 by our customers`
        : 'What our customers say'}
      body={`${sortedTestimonials.length > 0 ? `${sortedTestimonials.length} verified reviews` : 'Genuine feedback'} from real customers across our service area.`}
      cta={{ label: 'Leave a review', href: 'https://g.page/r/YOUR-GOOGLE-REVIEW-LINK', }}
      secondaryCta={{ label: 'Get a quote', href: '/contact' }}
    />

    <!-- ② TESTIMONIALS — full grid, all reviews -->
    {sortedTestimonials.length > 0 ? (
      <TestimonialRow
        heading="Customer reviews"
        variant="cards"
        columns={3}
        surface="subtle"
        items={sortedTestimonials}
      />
    ) : (
      <!-- Fallback if no testimonials in CMS yet -->
      <section class="reviews-empty section surface-subtle" aria-label="Reviews">
        <div class="section__inner" style="text-align: center; padding-block: var(--space-2xl);">
          <p style="color: var(--color-text-muted); font-size: var(--text-md);">
            Reviews coming soon. Check back shortly.
          </p>
        </div>
      </section>
    )}

    <!-- ③ LOGO BAR — review platforms + accreditation bodies -->
    <LogoBar
      heading="Find us on"
      variant="static"
      surface="base"
      items={[
        { src: '/images/logos/google-reviews.svg',   alt: 'Google Reviews',    width: 120, height: 40 },
        { src: '/images/logos/trustpilot.svg',        alt: 'Trustpilot',        width: 110, height: 40 },
        { src: '/images/logos/checkatrade.svg',       alt: 'Checkatrade',       width: 130, height: 40 },
        { src: '/images/logos/which-trusted.svg',     alt: 'Which? Trusted Trader', width: 100, height: 40 },
      ]}
    />

    <!-- ④ CTA BAND -->
    <CTABand
      heading="Ready to join our happy customers?"
      body="Free quotes, no obligation. Most jobs booked within the week."
      primaryCta={{ label: 'Get a free quote', href: '/contact' }}
      secondaryCta={{ label: 'See our services', href: '/services' }}
    />

  </main>
</Layout>
