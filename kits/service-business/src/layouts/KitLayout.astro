---
/**
 * KitLayout.astro
 * Service Business kit — page layout.
 * Wires Nav and Footer into Base.astro slots.
 * Used by every page in this kit.
 *
 * All SEO/meta props are passed through to Base.astro.
 * schemaType is fixed to 'LocalBusiness' for this kit —
 * service businesses are local entities, not organisations.
 *
 * Usage:
 *   ---
 *   import Layout from '../layouts/KitLayout.astro';
 *   ---
 *   <Layout title="About us" description="We do X for Y.">
 *     <main id="main-content" tabindex="-1">
 *       <Hero ... />
 *     </main>
 *   </Layout>
 */

import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, ogImage, canonical, noindex, breadcrumbs } = Astro.props;
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  canonical={canonical}
  noindex={noindex}
  breadcrumbs={breadcrumbs}
  schemaType='LocalBusiness'
>
  <Nav slot='nav' />
  <slot />
  <Footer slot='footer' />
</Base>
