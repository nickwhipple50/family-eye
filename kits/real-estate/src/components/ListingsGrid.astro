---
/**
 * ListingsGrid
 * CMS-driven property listings grid.
 * Kit-specific — lives in kits/real-estate/src/components/.
 * Not part of the shared packages/components library.
 *
 * Props (max 6 — T1 rule):
 *   items      Listing[]                   required  From Decap listings collection
 *   heading    string?                               Section heading
 *   body       string?                               Supporting paragraph
 *   columns    2 | 3                       default: 3
 *   surface    'base' | 'subtle'           default: 'base'
 *   maxItems   number?                     default: 6 — how many to show
 *                                          Allows the home page to show 3
 *                                          and the listings page to show all.
 *
 * Listing (mirrors Decap listings collection schema):
 *   title        string    Property address or name
 *   price        string    Display price — string to handle "POA", ranges, etc.
 *   status       'for-sale' | 'for-rent' | 'sold' | 'let'
 *   bedrooms     number?
 *   bathrooms    number?
 *   area         string?   Floor area — e.g. "1,200 sq ft" or "110 m²"
 *   description  string?   Short description — 1–2 sentences
 *   image        { src: string; alt: string; width: number; height: number }
 *   location     string?   Neighbourhood or suburb
 *   featured     boolean?  Highlights this listing
 *
 * Status badges:
 *   for-sale → "For Sale"  (accent colour)
 *   for-rent → "To Let"    (primary colour)
 *   sold     → "Sold"      (muted, greyed out card)
 *   let      → "Let"       (muted, greyed out card)
 *
 * Note on IDX / MLS:
 *   Real-time IDX or MLS feeds = T2 trigger. This component uses
 *   Decap CMS only — manually managed listings. If client needs
 *   live MLS data, re-scope before building.
 *
 * Usage:
 *   ---
 *   import ListingsGrid from '../components/ListingsGrid.astro';
 *   import { getCollection } from 'astro:content';
 *   const listings = await getCollection('listings');
 *   ---
 *   <ListingsGrid
 *     heading="Current listings"
 *     columns={3}
 *     maxItems={6}
 *     items={listings
 *       .sort((a, b) => a.data.order - b.data.order)
 *       .map(l => l.data)}
 *   />
 */

interface ListingImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

type ListingStatus = 'for-sale' | 'for-rent' | 'sold' | 'let';

interface Listing {
  title: string;
  price: string;
  status: ListingStatus;
  bedrooms?: number;
  bathrooms?: number;
  area?: string;
  description?: string;
  image: ListingImage;
  location?: string;
  featured?: boolean;
}

interface Props {
  items: Listing[];
  heading?: string;
  body?: string;
  columns?: 2 | 3;
  surface?: 'base' | 'subtle';
  maxItems?: number;
}

const { items, heading, body, columns = 3, surface = 'base', maxItems = 6 } = Astro.props;

const displayItems = items.slice(0, maxItems);

const statusLabel: Record<ListingStatus, string> = {
  'for-sale': 'For Sale',
  'for-rent': 'To Let',
  sold: 'Sold',
  let: 'Let',
};

const isInactive = (status: ListingStatus) => status === 'sold' || status === 'let';
---

<section
  class={`listings-grid section surface-${surface}`}
  aria-label={heading ?? 'Property listings'}
>
  <div class='listings-grid__inner section__inner'>
    {
      (heading || body) && (
        <div
          class='section__header'
          data-reveal
        >
          {heading && <h2 class='section__heading'>{heading}</h2>}
          {body && <p class='section__body'>{body}</p>}
        </div>
      )
    }

    <ul
      class={`listings-grid__grid listings-grid__grid--cols-${columns}`}
      data-reveal-group
    >
      {
        displayItems.map((listing, index) => (
          <li
            class={`listings-grid__card${listing.featured ? ' listings-grid__card--featured' : ''}${isInactive(listing.status) ? ' listings-grid__card--inactive' : ''}`}
            data-reveal
            style={`--item-index: ${index}`}
          >
            {/* Image */}
            <div class='listings-grid__image-wrap'>
              <img
                src={listing.image.src}
                alt={listing.image.alt}
                width={listing.image.width}
                height={listing.image.height}
                loading={index < columns ? 'eager' : 'lazy'}
                decoding='async'
                class='listings-grid__image'
              />
              {/* Status badge */}
              <span class={`listings-grid__status listings-grid__status--${listing.status}`}>
                {statusLabel[listing.status]}
              </span>
              {listing.featured && <span class='listings-grid__featured-badge'>Featured</span>}
            </div>

            {/* Card body */}
            <div class='listings-grid__body'>
              <div class='listings-grid__title-row'>
                <h3 class='listings-grid__title'>{listing.title}</h3>
                {listing.location && <p class='listings-grid__location'>{listing.location}</p>}
              </div>

              <p class='listings-grid__price'>{listing.price}</p>

              {/* Property details */}
              {(listing.bedrooms || listing.bathrooms || listing.area) && (
                <ul
                  class='listings-grid__details'
                  aria-label='Property details'
                >
                  {listing.bedrooms !== undefined && (
                    <li class='listings-grid__detail'>
                      <svg
                        width='16'
                        height='16'
                        viewBox='0 0 24 24'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='1.75'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        aria-hidden='true'
                        focusable='false'
                      >
                        <path d='M3 7v11M21 7v11M3 12h18M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2' />
                        <path d='M9 12v-1a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1' />
                      </svg>
                      <span>
                        {listing.bedrooms} <span class='sr-only'>bedrooms</span>
                      </span>
                    </li>
                  )}
                  {listing.bathrooms !== undefined && (
                    <li class='listings-grid__detail'>
                      <svg
                        width='16'
                        height='16'
                        viewBox='0 0 24 24'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='1.75'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        aria-hidden='true'
                        focusable='false'
                      >
                        <path d='M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5' />
                        <line
                          x1='10'
                          x2='8'
                          y1='5'
                          y2='7'
                        />
                        <line
                          x1='2'
                          x2='22'
                          y1='12'
                          y2='12'
                        />
                      </svg>
                      <span>
                        {listing.bathrooms} <span class='sr-only'>bathrooms</span>
                      </span>
                    </li>
                  )}
                  {listing.area && (
                    <li class='listings-grid__detail'>
                      <svg
                        width='16'
                        height='16'
                        viewBox='0 0 24 24'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='1.75'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        aria-hidden='true'
                        focusable='false'
                      >
                        <path d='M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z' />
                      </svg>
                      <span>{listing.area}</span>
                    </li>
                  )}
                </ul>
              )}

              {listing.description && (
                <p class='listings-grid__description'>{listing.description}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ============================================================
     GRID
     ============================================================ */

  .listings-grid__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-card-gap);
  }

  @media (min-width: 600px) {
    .listings-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .listings-grid__grid--cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ============================================================
     CARD
     ============================================================ */

  .listings-grid__card {
    display: flex;
    flex-direction: column;
    background-color: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    box-shadow: var(--card-shadow);
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .listings-grid--surface-subtle .listings-grid__card {
    background-color: var(--color-surface-base);
  }

  .listings-grid__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .listings-grid__card--featured {
    border-color: var(--color-accent);
    border-width: 2px;
  }

  .listings-grid__card--inactive {
    opacity: 0.65;
    pointer-events: none;
  }

  /* ============================================================
     IMAGE
     ============================================================ */

  .listings-grid__image-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }

  .listings-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .listings-grid__card:hover .listings-grid__image {
    transform: scale(1.04);
  }

  /* ============================================================
     BADGES
     ============================================================ */

  .listings-grid__status {
    position: absolute;
    top: var(--space-s);
    left: var(--space-s);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding-block: var(--space-3xs);
    padding-inline: var(--space-xs);
    border-radius: var(--radius-badge);
    color: white;
  }

  .listings-grid__status--for-sale {
    background-color: var(--color-accent);
  }
  .listings-grid__status--for-rent {
    background-color: var(--color-primary);
  }
  .listings-grid__status--sold,
  .listings-grid__status--let {
    background-color: var(--color-text-muted);
  }

  .listings-grid__featured-badge {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding-block: var(--space-3xs);
    padding-inline: var(--space-xs);
    border-radius: var(--radius-badge);
    background-color: color-mix(in srgb, black 60%, transparent);
    color: white;
    backdrop-filter: blur(4px);
  }

  /* ============================================================
     CARD BODY
     ============================================================ */

  .listings-grid__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--card-padding);
    flex: 1;
  }

  .listings-grid__title-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .listings-grid__title {
    font-family: var(--font-heading);
    font-size: var(--text-h5);
    font-weight: var(--font-weight-heading, var(--font-weight-bold));
    line-height: var(--leading-snug);
    color: var(--color-text-heading);
    margin: 0;
  }

  .listings-grid__location {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .listings-grid__price {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    margin: 0;
  }

  /* ============================================================
     PROPERTY DETAILS
     ============================================================ */

  .listings-grid__details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .listings-grid__detail {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .listings-grid__detail svg {
    flex-shrink: 0;
    color: var(--color-text-subtle);
  }

  .listings-grid__description {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
