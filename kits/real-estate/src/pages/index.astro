---
/**
 * pages/index.astro
 * Real Estate kit — Home page
 *
 * Sections:
 *   1. Hero         — fullbleed, strong property image
 *   2. StatsRow     — properties sold, avg days on market, rating, years in business
 *   3. ServiceList  — buyer / seller / property management services
 *   4. TestimonialRow
 *   5. LogoBar      — industry memberships, certifications, awards
 *   6. CTABand      — "Get a free appraisal"
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, StatsRow, ServiceList, TestimonialRow, LogoBar, CTABand } from '@mmm/components';
import { getCollection, getEntry } from 'astro:content';

const services = await getCollection('services');
const testimonials = await getCollection('testimonials');
const settings = (await getEntry('site_settings', 'general'))?.data;

const sortedServices = services
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 6)
  .map((s) => s.data);

const sortedTestimonials = testimonials
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3)
  .map((t) => t.data);
---

<Layout
  title='Home'
  description={settings?.seo?.description}
>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO — fullbleed, lead with a strong property photo -->
    <Hero
      variant='fullbleed'
      heading='Find your place in Anytown'
      body="Trusted real estate experts helping buyers and sellers navigate one of life's biggest decisions — with honesty, local knowledge, and results."
      cta={{ label: 'Browse listings', href: '/listings' }}
      secondaryCta={{ label: 'Get a free appraisal', href: '/contact' }}
      image={{ src: '/images/hero-home.jpg', alt: 'Luxury home exterior at dusk' }}
    />

    <!-- ② STATS ROW — track record anchors -->
    <StatsRow
      variant='band'
      surface='inverse'
      items={[
        { value: 320, suffix: '+', label: 'Homes sold' },
        { value: 18, label: 'Avg. days on market' },
        { value: 4.9, suffix: '★', label: 'Client rating', decimals: 1 },
        { value: 16, suffix: '+', label: 'Years in business' },
      ]}
    />

    <!-- ③ SERVICE LIST — buyer / seller / property management -->
    <ServiceList
      heading='How we can help'
      body="Whether you're buying, selling, or investing — we have the expertise to guide you."
      variant='grid-icon'
      columns={3}
      surface='base'
      items={sortedServices}
    />

    <!-- ④ TESTIMONIALS -->
    <TestimonialRow
      heading='What our clients say'
      variant='cards'
      columns={3}
      surface='subtle'
      items={sortedTestimonials}
    />

    <!-- ⑤ LOGO BAR — industry memberships and certifications -->
    <LogoBar
      heading='Proud members of'
      variant='static'
      surface='base'
      items={[
        {
          src: '/images/logos/nar.svg',
          alt: 'National Association of Realtors',
          width: 80,
          height: 40,
        },
        { src: '/images/logos/mls.svg', alt: 'Multiple Listing Service', width: 80, height: 40 },
        {
          src: '/images/logos/equal-housing.svg',
          alt: 'Equal Housing Opportunity',
          width: 40,
          height: 40,
        },
        { src: '/images/logos/realtor.svg', alt: 'Realtor', width: 100, height: 40 },
      ]}
    />

    <!-- ⑥ CTA BAND -->
    <CTABand
      heading='Thinking of selling?'
      body='Find out what your home is worth with a free, no-obligation market appraisal.'
      eyebrow='Free appraisal'
      primaryCta={{ label: 'Schedule an appraisal', href: '/contact' }}
      secondaryCta={{ label: 'View active listings', href: '/listings' }}
    />
  </main>
</Layout>
