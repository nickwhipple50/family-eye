---
/**
 * pages/index.astro
 * Professional Services kit — Home page
 *
 * Sections:
 *   1. Hero        — split, founder or team photo
 *   2. LogoBar     — client logos or industry accreditations
 *   3. FeatureGrid — core service areas, brief
 *   4. TestimonialRow
 *   5. CTABand     — "Schedule a consultation"
 *
 * Note: t1.md flags About as the highest-value page for this kit.
 * The Home page should create enough credibility to move visitors to
 * About — not try to close them on the first visit. Keep it focused.
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, LogoBar, FeatureGrid, TestimonialRow, CTABand } from '@mmm/components';
import { getCollection, getEntry } from 'astro:content';

const services = await getCollection('services');
const testimonials = await getCollection('testimonials');
const settings = (await getEntry('site_settings', 'general'))?.data;

const sortedServices = services
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 6)
  .map((s) => s.data);

const sortedTestimonials = testimonials
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3)
  .map((t) => t.data);
---

<Layout
  title='Home'
  description={settings?.seo?.description}
>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO — split, professional portrait or team photo -->
    <Hero
      variant='split'
      heading='Straight answers. Practical advice. Real results.'
      body='We work with founders, executives, and business owners who need clear thinking and experienced counsel — not more complexity.'
      cta={{ label: 'Schedule a consultation', href: '/contact' }}
      secondaryCta={{ label: 'Our services', href: '/services' }}
      image={{ src: '/images/hero-home.jpg', alt: 'Advisor meeting with a client' }}
    />

    <!-- ② LOGO BAR — client logos or accreditation bodies -->
    <!--
      Kit author: use client logos with permission, or industry body
      logos (chamber of commerce, professional associations, certifications).
      Avoid filler logos — blank is better than unrecognizable.
    -->
    <LogoBar
      heading='Trusted by organizations like'
      variant='marquee'
      surface='subtle'
      items={[
        { src: '/images/logos/client-1.svg', alt: 'Client One', width: 120, height: 40 },
        { src: '/images/logos/client-2.svg', alt: 'Client Two', width: 100, height: 40 },
        { src: '/images/logos/client-3.svg', alt: 'Client Three', width: 110, height: 40 },
        { src: '/images/logos/client-4.svg', alt: 'Client Four', width: 90, height: 40 },
        { src: '/images/logos/client-5.svg', alt: 'Client Five', width: 120, height: 40 },
      ]}
    />

    <!-- ③ FEATURE GRID — core service areas -->
    {
      sortedServices.length > 0 ? (
        <FeatureGrid
          heading='How we can help'
          body='We focus on a few things and do them exceptionally well.'
          variant='cards'
          columns={3}
          surface='base'
          items={sortedServices.map((s) => ({
            icon: s.icon,
            heading: s.name,
            body: s.description,
          }))}
        />
      ) : (
        <FeatureGrid
          heading='How we can help'
          body='We focus on a few things and do them exceptionally well.'
          variant='cards'
          columns={3}
          surface='base'
          items={[
            {
              icon: 'briefcase',
              heading: 'Strategic Advisory',
              body: 'Helping leadership teams make better decisions — faster, with more confidence, and with less risk.',
            },
            {
              icon: 'shield',
              heading: 'Compliance & Risk',
              body: 'Proactive guidance that keeps your business on the right side of regulatory requirements before issues arise.',
            },
            {
              icon: 'trending-up',
              heading: 'Growth Planning',
              body: 'From market entry to acquisition strategy — practical planning that translates to execution.',
            },
            {
              icon: 'file-text',
              heading: 'Contracts & Agreements',
              body: 'Clear, enforceable agreements that protect your interests and hold up under pressure.',
            },
            {
              icon: 'users',
              heading: 'Organizational Design',
              body: 'Helping teams grow without losing the clarity and culture that made them effective.',
            },
            {
              icon: 'bar-chart',
              heading: 'Financial Advisory',
              body: 'Objective analysis of your numbers — what they mean, where the risks are, and what to do next.',
            },
          ]}
        />
      )
    }

    <!-- ④ TESTIMONIALS -->
    {
      sortedTestimonials.length > 0 && (
        <TestimonialRow
          heading='What our clients say'
          variant='cards'
          columns={3}
          surface='subtle'
          items={sortedTestimonials}
        />
      )
    }

    <!-- ⑤ CTA BAND -->
    <CTABand
      heading='Not sure where to start?'
      body="The first conversation is always free. We'll tell you honestly whether we're the right fit — and if we're not, we'll point you toward someone who is."
      eyebrow='Free consultation'
      primaryCta={{ label: 'Schedule a consultation', href: '/contact' }}
      secondaryCta={{ label: 'Learn about our process', href: '/process' }}
    />
  </main>
</Layout>
