---
/**
 * KitLayout.astro
 * Professional Services kit — page layout.
 * Wires Nav and Footer into Base.astro slots.
 *
 * schemaType is 'ProfessionalService' — more specific than Organization
 * and qualifies for Google's professional service rich results.
 * Kit author: for law firms use 'LegalService', for accounting use
 * 'AccountingService', for financial advisors use 'FinancialService'.
 * These are all valid Schema.org subtypes of ProfessionalService.
 */

import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, ogImage, canonical, noindex, breadcrumbs } = Astro.props;
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  canonical={canonical}
  noindex={noindex}
  breadcrumbs={breadcrumbs}
  schemaType='LocalBusiness'
>
  <Nav slot='nav' />
  <slot />
  <Footer slot='footer' />
</Base>
