---
/**
 * pages/index.astro
 * Restaurant & Food kit — Home page
 *
 * Sections:
 *   1. Hero         — fullbleed, strong food or atmosphere photo
 *   2. StatsRow     — years open, guests served, rating, days/week open
 *   3. MenuSection  — featured items only, drives to full Menu page
 *   4. TestimonialRow
 *   5. CTABand      — "Reserve a table"
 *
 * Note: hours + location are on the Visit page, not the Home page.
 * The floating CTA (site_settings.floating_cta) handles the persistent
 * reservation prompt — no need to duplicate it in the hero CTAs.
 */

import Layout from '../layouts/KitLayout.astro';
import { Hero, StatsRow, TestimonialRow, CTABand } from '@mmm/components';
import MenuSection from '../components/MenuSection.astro';
import { getCollection, getEntry } from 'astro:content';

const menuItems = await getCollection('menu');
const testimonials = await getCollection('testimonials');
const settings = (await getEntry('site_settings', 'general'))?.data;

// Featured items only — max 6 to keep the section tight
const featuredItems = menuItems
  .filter((i) => i.data.featured)
  .sort(
    (a, b) =>
      (a.data.category_order ?? 0) - (b.data.category_order ?? 0) ||
      (a.data.item_order ?? 0) - (b.data.item_order ?? 0)
  )
  .slice(0, 6)
  .map((i) => i.data);

const sortedTestimonials = testimonials
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3)
  .map((t) => t.data);

const siteName = settings?.site_name ?? 'us';
---

<Layout
  title='Home'
  description={settings?.seo?.description}
>
  <main
    id='main-content'
    tabindex='-1'
  >
    <!-- ① HERO — fullbleed, food or atmosphere photography -->
    <Hero
      variant='fullbleed'
      heading='Made from scratch. Every day.'
      body="Classic American cooking using fresh, local ingredients — the way it's always been done. Dine in or take out."
      cta={{ label: 'View our menu', href: '/menu' }}
      secondaryCta={{ label: 'Reserve a table', href: '/visit#reservations' }}
      image={{
        src: '/images/hero-home.jpg',
        alt: 'Plates of food on a table at The Red Barn Kitchen',
      }}
    />

    <!-- ② STATS ROW -->
    <StatsRow
      variant='band'
      surface='inverse'
      items={[
        { value: 37, suffix: '+', label: 'Years open' },
        { value: 10000, suffix: '+', label: 'Guests served' },
        { value: 4.8, suffix: '★', label: 'Average rating', decimals: 1 },
        { value: 6, label: 'Days a week' },
      ]}
    />

    <!-- ③ MENU SECTION — featured items only -->
    {
      featuredItems.length > 0 && (
        <MenuSection
          heading='From our kitchen'
          body='A few of our most-loved dishes. See the full menu for everything we make.'
          items={featuredItems}
          showCategories={false}
          surface='subtle'
          cta={{ label: 'See the full menu', href: '/menu' }}
        />
      )
    }

    <!-- ④ TESTIMONIALS -->
    {
      sortedTestimonials.length > 0 && (
        <TestimonialRow
          heading='What our guests say'
          variant='cards'
          columns={3}
          surface='base'
          items={sortedTestimonials}
        />
      )
    }

    <!-- ⑤ CTA BAND -->
    <CTABand
      heading={`Come see us at ${siteName}`}
      body='Open Tuesday through Sunday. Walk-ins welcome — reservations recommended on weekends.'
      eyebrow="We'd love to have you"
      primaryCta={{ label: 'Reserve a table', href: '/visit#reservations' }}
      secondaryCta={{ label: 'Get directions', href: '/visit' }}
    />
  </main>
</Layout>
