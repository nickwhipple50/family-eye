---
/**
 * ProseLayout.astro
 * Layout for CMS-driven prose pages — privacy policy, terms of use, etc.
 * Wraps KitLayout with a constrained prose column and basic heading styles.
 * Content is rendered via set:html from the CMS markdown widget.
 *
 * Props:
 *   title        string   Page title
 *   description  string?  Meta description
 *   noindex      boolean? default: false — set true for legal pages if preferred
 */

import KitLayout from './KitLayout.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<KitLayout
  title={title}
  description={description}
  noindex={noindex}
>
  <main
    id='main-content'
    tabindex='-1'
    class='prose-page'
  >
    <div class='prose-page__inner'>
      <slot />
    </div>
  </main>
</KitLayout>

<style>
  .prose-page {
    padding-block-start: calc(var(--nav-height) + var(--space-2xl));
    padding-block-end: var(--space-2xl);
    padding-inline: var(--gutter);
  }

  .prose-page__inner {
    max-width: var(--max-width-narrow);
    margin-inline: auto;
  }

  /* ============================================================
     PROSE STYLES
     Scoped to .prose-page so they only affect CMS-rendered HTML.
     Covers the elements a markdown widget can produce.
     ============================================================ */

  .prose-page :global(h1) {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: var(--font-weight-heading, var(--font-weight-bold));
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-heading);
    margin: 0 0 var(--space-l);
  }

  .prose-page :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--font-weight-heading, var(--font-weight-bold));
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    color: var(--color-text-heading);
    margin: var(--space-xl) 0 var(--space-s);
  }

  .prose-page :global(h3) {
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: var(--font-weight-heading, var(--font-weight-bold));
    line-height: var(--leading-snug);
    color: var(--color-text-heading);
    margin: var(--space-l) 0 var(--space-xs);
  }

  .prose-page :global(p) {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-base);
    margin: 0 0 var(--space-m);
    max-width: var(--measure-default);
  }

  .prose-page :global(ul),
  .prose-page :global(ol) {
    padding-inline-start: var(--space-l);
    margin: 0 0 var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .prose-page :global(li) {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-base);
  }

  .prose-page :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .prose-page :global(a:hover) {
    color: var(--color-accent-dark);
  }

  .prose-page :global(strong) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-heading);
  }

  .prose-page :global(hr) {
    border: none;
    border-block-start: 1px solid var(--color-border);
    margin-block: var(--space-xl);
  }

  .prose-page :global(blockquote) {
    border-inline-start: 3px solid var(--color-accent);
    padding-inline-start: var(--space-m);
    margin-inline: 0;
    margin-block: var(--space-m);
    color: var(--color-text-muted);
  }
</style>
