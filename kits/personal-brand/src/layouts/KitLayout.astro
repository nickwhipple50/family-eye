---
/**
 * KitLayout.astro
 * Personal Brand kit — page layout.
 *
 * schemaType is 'Person' — the brand is the individual.
 * This surfaces name, job title, and social links in structured data,
 * which can appear in Google's knowledge panel for the individual.
 *
 * Kit author: Base.astro handles the Person schema output.
 * Ensure site_settings.contact has a real email set — it's used
 * as the Person's contact point in the schema.
 */

import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, ogImage, canonical, noindex, breadcrumbs } = Astro.props;
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  canonical={canonical}
  noindex={noindex}
  breadcrumbs={breadcrumbs}
  schemaType='LocalBusiness'
>
  <Nav slot='nav' />
  <slot />
  <Footer slot='footer' />
</Base>
